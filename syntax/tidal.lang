<?xml version="1.0" encoding="UTF-8"?>
<language id="tidal" _name="Tidal Cycles" version="3.0" _section="Sources">
  <metadata>
    <property name="mimetypes">text/x-tidal</property>
    <property name="globs">*.tidal</property>
    <property name="line-comment-start">--</property>
    <property name="block-comment-start">{-</property>
    <property name="block-comment-end">-}</property>
  </metadata>

  <styles>
    <style id="comment" _name="Comment" map-to="def:comment"/>
    <style id="keyword" _name="Keyword" map-to="def:keyword"/>
    <style id="function" _name="Tidal Function" map-to="def:function"/>
    <style id="string" _name="String (Pattern)" map-to="def:string"/>
    <style id="number" _name="Number" map-to="def:decimal"/>
    <style id="operator" _name="Operator" map-to="def:operator"/>
  </styles>

  <definitions>
    <context id="tidal" class="no-spell-check">
      <include>
        <context id="line-comment" style-ref="comment" end-at-line-end="true">
          <start>--</start>
        </context>
        
        <context id="block-comment" style-ref="comment">
          <start>\{-</start>
          <end>-\}</end>
        </context>

        <context id="string" style-ref="string">
          <start>"</start>
          <end>"</end>
        </context>

        <context id="number" style-ref="number">
          <match>\b([0-9]+(\.[0-9]+)?)\b</match>
        </context>

        <context id="keywords" style-ref="keyword">
          <keyword>let</keyword>
          <keyword>in</keyword>
          <keyword>do</keyword>
          <keyword>import</keyword>
          <keyword>where</keyword>
        </context>

        <context id="tidal-functions" style-ref="function">
          <keyword>d1</keyword>
          <keyword>d2</keyword>
          <keyword>d3</keyword>
          <keyword>d4</keyword>
          <keyword>d5</keyword>
          <keyword>d6</keyword>
          <keyword>d7</keyword>
          <keyword>d8</keyword>
          <keyword>sound</keyword>
          <keyword>s</keyword>
          <keyword>note</keyword>
          <keyword>gain</keyword>
          <keyword>speed</keyword>
          <keyword>pan</keyword>
          <keyword>vowel</keyword>
          <keyword>cutoff</keyword>
          <keyword>resonance</keyword>
          <keyword>cps</keyword>
          <keyword>hush</keyword>
          <keyword>jux</keyword>
          <keyword>every</keyword>
          <keyword>fast</keyword>
          <keyword>slow</keyword>
          <keyword>rev</keyword>
          <keyword>striate</keyword>
          <keyword>degrade</keyword>
          <keyword>silence</keyword>
        </context>

        <context id="operators" style-ref="operator">
          <match>[\$#\+\-\*\/Unique]</match>
        </context>

      </include>
    </context>
  </definitions>
</language>
